<?xml version="1.0"?>
<Container version="2">
  <Name>safeincloud-novnc</Name>
  <Repository>ghcr.io/mspdaniel/safeincloud-novnc:latest</Repository>
  <Registry>https://ghcr.io</Registry>
  <Network>bridge</Network>
  <WebUI>http://[IP]:[PORT:5800]/vnc.html?autoconnect=true</WebUI>
  <Overview>SafeInCloud Windows portable under Wine with noVNC. Unofficial community container.</Overview>
  <Category>Tools:</Category>
  <ExtraParams>--shm-size=256m --memory=3g --pids-limit=512 --security-opt=no-new-privileges:true</ExtraParams>
  <Config Name="WebUI" Target="5800" Default="5811" Mode="tcp" Description="noVNC HTTP" Type="Port" Display="always" Required="true" Mask="false">5811</Config>
  <Config Name="Config" Target="/config" Default="/mnt/user/appdata/safeincloud-novnc/config" Mode="rw" Description="Persistent Wine prefix, app and database" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/safeincloud-novnc/config</Config>
  <Config Name="Official Portable App Files" Target="/opt/safeincloud/source" Default="/mnt/user/appdata/safeincloud-novnc/source" Mode="ro" Description="Official Windows portable application extracted here" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/safeincloud-novnc/source</Config>
  <Config Name="USER_ID" Target="USER_ID" Default="99" Mode="" Description="Unraid UID" Type="Variable" Display="advanced" Required="true" Mask="false">99</Config>
  <Config Name="GROUP_ID" Target="GROUP_ID" Default="100" Mode="" Description="Unraid GID" Type="Variable" Display="advanced" Required="true" Mask="false">100</Config>
  <Config Name="INSTALL_DOTNET48" Target="INSTALL_DOTNET48" Default="0" Mode="" Description="Only use 1 to manually install .NET if not prebuilt" Type="Variable" Display="advanced" Required="true" Mask="false">0</Config>
</Container>
